# ==============================================================================
# BACKEND / SERVER-ONLY VARIABLES (NEVER exposed to the browser)
# ==============================================================================

# Neon PostgreSQL connection string (use the pooled connection string from Neon)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret key to authenticate /api/admin/* endpoints and /admin panel
ADMIN_SECRET="change-me-to-a-strong-random-secret"

# ==============================================================================
# FRONTEND / CLIENT VARIABLES (Exposed to the browser via NEXT_PUBLIC_ prefix)
# ==============================================================================

# Public base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional external API base URL (leave empty to use Next.js built-in /api routes)
NEXT_PUBLIC_API_URL=""

# Public WhatsApp number for drop alerts and wholesale contact
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"
